{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/stream.ts": {
      "maxDuration": 300
    },
    "api/send.ts": {
      "maxDuration": 120
    },
    "api/import.ts": {
      "maxDuration": 60
    }
  },
  "regions": [
    "fra1"
  ]
}
