# Public HTTPS address of the deployed Mini App (no trailing slash)
PUBLIC_APP_URL=https://tapehouse.example.com
# From @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string; Telegram sends it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=
# Long random string that signs stream links (keep it when rotating the bot token)
TAPEHOUSE_SIGNING_SECRET=
# Local preview only: lets the app run in a normal browser as this Telegram user ("id:name")
TAPEHOUSE_DEV_USER=
# Blob credentials (BLOB_STORE_ID / VERCEL_OIDC_TOKEN) come from `vercel env pull`
